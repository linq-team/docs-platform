{
  "name": "stl-api-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:ci": "turbo run build:ci",
    "build:packages": "turbo run build --filter=@stainless-api/ui-primitives --filter=@stainless-api/docs-ui --filter=@stainless-api/docs-search",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "preview": "turbo run preview",
    "format": "prettier --write .",
    "check": "turbo run check",
    "check:types": "turbo run check:types",
    "check:types:coverage": "./scripts/check-tsconfig-coverage.ts",
    "check:types:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "check:format": "prettier --check .",
    "test": "turbo run test",
    "vendor-deps": "turbo run vendor-deps",
    "knip": "knip"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "knip": "^6.11.0",
    "prettier": "catalog:",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.9.10",
    "typescript": "catalog:",
    "typescript-plugin-css-modules": "^5.2.0"
  },
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.12.0"
  }
}
